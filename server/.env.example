PORT=5000
# Neon connection string (Neon dashboard → Connect). Leave empty to run without a database.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# The admin panel sign-in. Change the password here and restart to reset it.
ADMIN_EMAIL=admin@flairmantra.in
ADMIN_PASSWORD=choose-a-strong-password
JWT_SECRET=replace-with-a-long-secret
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dev01.zerodimensions@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=FlairMantra <dev01.zerodimensions@gmail.com>
